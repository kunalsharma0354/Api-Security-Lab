# NEXORA API Security Lab — environment template
# Copy to `.env` (backend) and adjust. Never commit real secrets.

# ---- Backend server ----
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,https://nexoralab-phi.vercel.app

# ---- Rate limiting (Part 3) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---- API key authentication (Part 4) ----
DEMO_API_KEY=nexora_demo_key_change_me

# ---- Request size protection (Part 6) ----
PAYLOAD_MAX_KB=64

# ---- Timeout protection (Part 7) ----
TIMEOUT_MS=2000

# ---- Multi-layer protection (Part 8) ----
PROTECTED_RATE_LIMIT_MAX=5
PROTECTED_RATE_LIMIT_WINDOW_SECONDS=60

# ---- API key issuer (Part 9) ----
KEY_ISSUE_MAX=10
KEY_ISSUE_WINDOW_SECONDS=300

# ---- Frontend (optional) ----
# VITE_API_BASE_URL=http://localhost:3001
