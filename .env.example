# NEXORA API Security Lab — environment template
# Copy to `.env` (backend) and adjust. Never commit real secrets.

# ---- Backend server ----
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ---- Rate limiting (Part 3) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---- API key authentication (Part 4) ----
DEMO_API_KEY=nexora_demo_key_change_me

# ---- Frontend (optional) ----
# VITE_API_BASE_URL=http://localhost:3001

# Future parts will add configuration for payload limits and timeouts.
