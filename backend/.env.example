# NEXORA backend environment
# Copy to `.env` and adjust as needed. Never commit real secrets.

PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Rate limiting (Part 3) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---- API key authentication (Part 4) ----
# Development/demo key for the /api/auth lab. The server REFUSES to start
# without it. This is a public demo value — replace it for any real use and
# never commit a genuine secret here.
DEMO_API_KEY=nexora_demo_key_change_me

# ---- Request size protection (Part 6) ----
PAYLOAD_MAX_KB=64

# ---- Timeout protection (Part 7) ----
TIMEOUT_MS=2000

# ---- Multi-layer protection (Part 8) ----
PROTECTED_RATE_LIMIT_MAX=5
PROTECTED_RATE_LIMIT_WINDOW_SECONDS=60
